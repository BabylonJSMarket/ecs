{
  "name": "@babylonjsmarket/ecs",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Entity-Component-System framework with Babylon and Three renderer adapters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babylonjsmarket/ecs.git"
  },
  "author": "BabylonJS Market",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./babylon": {
      "types": "./dist/babylon.d.ts",
      "import": "./dist/babylon.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./renderer-types": {
      "types": "./dist/Renderer/types.d.ts",
      "import": "./dist/Renderer/types.js"
    },
    "./viz": {
      "types": "./src/Viz/index.ts",
      "import": "./src/Viz/index.ts"
    }
  },
  "files": [
    "dist",
    "src/Viz",
    "src/ECS/EventBus/EventBus.viz.tsx",
    "src/ECS/EventBus/EventBus.panel.tsx",
    ".claude-plugin",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "@babylonjs/core": "*",
    "@babylonjs/loaders": "*",
    "@babylonjs/havok": "*",
    "three": "*",
    "solid-js": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "@babylonjs/loaders": {
      "optional": true
    },
    "@babylonjs/havok": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "^9.3.4",
    "@babylonjs/loaders": "^9.3.4",
    "@babylonjs/havok": "^1.3.12",
    "@solidjs/testing-library": "^0.8.10",
    "@types/three": "^0.184.0",
    "jsdom": "^27.3.0",
    "solid-js": "^1.9.3",
    "three": "^0.184.0",
    "typescript": "^5.3.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.0.0"
  }
}

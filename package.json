{
  "name": "@babylonjsmarket/ecs",
  "version": "0.7.0",
  "type": "module",
  "license": "MIT",
  "description": "Entity-Component-System framework with Babylon and Three renderer adapters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babylonjsmarket/ecs.git"
  },
  "author": "BabylonJS Market",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./babylon": {
      "types": "./dist/babylon.d.ts",
      "import": "./dist/babylon.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./babylon-lite": {
      "types": "./dist/babylon-lite.d.ts",
      "import": "./dist/babylon-lite.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./renderer-types": {
      "types": "./dist/Renderer/types.d.ts",
      "import": "./dist/Renderer/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "npm run build && echo '\\nEventBus benchmark is real-browser only (jsdom mis-measures native events).\\nServe the package root and open the page:\\n  python3 -m http.server 8080\\n  open http://localhost:8080/src/ECS/EventBus/EventBus.bench.html\\n'",
    "examples:build": "esbuild examples/compare.app.ts --bundle --format=esm --outfile=examples/compare.bundle.js --external:three --external:@babylonjs/* --external:@dimforge/*",
    "examples": "node --experimental-strip-types examples/dev-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm run test:coverage"
  },
  "peerDependencies": {
    "@babylonjs/core": "*",
    "@babylonjs/havok": "*",
    "@babylonjs/lite": "*",
    "@babylonjs/loaders": "*",
    "@dimforge/rapier3d-compat": "*",
    "solid-js": "^1.8.0",
    "three": "*"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "@babylonjs/loaders": {
      "optional": true
    },
    "@babylonjs/havok": {
      "optional": true
    },
    "@babylonjs/lite": {
      "optional": true
    },
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "^9.3.4",
    "@babylonjs/havok": "^1.3.12",
    "@babylonjs/lite": "^1.0.1",
    "@babylonjs/loaders": "^9.3.4",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@solidjs/testing-library": "^0.8.10",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^27.3.0",
    "solid-js": "^1.9.3",
    "three": "^0.184.0",
    "typescript": "^5.3.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.0.0"
  }
}
